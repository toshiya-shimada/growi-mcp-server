# Required: GROWI instance URL (no trailing slash)
GROWI_BASE_URL=https://wiki.example.com

# Required: Personal API token issued at /me in GROWI settings
GROWI_ACCESS_TOKEN=your_access_token_here

# Required for deploy_page / preview_frontmatter: path to your local git repo of Markdown files
GROWI_CONTENT_ROOT=/path/to/your/wiki-content

# Set to true to enable write tools (deploy_page). Default: false
GROWI_ENABLE_WRITE_TOOLS=false

# Optional tuning
GROWI_TIMEOUT_MS=30000
GROWI_VERIFY_TLS=true
MCP_TRANSPORT=stdio
LOG_LEVEL=INFO
